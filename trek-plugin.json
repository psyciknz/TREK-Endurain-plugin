{
  "id": "endurain-import",
  "name": "Endurain Import",
  "version": "1.2.0",
  "apiVersion": 1,
  "author": "psyciknz",
  "description": "Browse Endurain activities and import selected activities into a TREK trip.",
  "homepage": "https://github.com/psyciknz/TREK-Endurain-plugin",
  "license": "MIT",
  "icon": "Footprints",
  "type": "trip-page",
  "trek": ">=4.2.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "db:own",
    "db:read:trips",
    "db:write:days",
    "db:write:places",
    "db:write:itinerary",
    "db:meta",
    "http:outbound"
  ],
  "operatorEgress": true,
  "settings": [
    {
      "key": "endurain_url",
      "label": "Endurain URL",
      "scope": "user",
      "required": true,
      "placeholder": "https://endurain.example.com"
    },
    {
      "key": "endurain_username",
      "label": "Endurain username",
      "scope": "user",
      "required": true,
      "placeholder": "Your Endurain username or email"
    },
    {
      "key": "endurain_password",
      "label": "Endurain password",
      "scope": "user",
      "required": true,
      "secret": true,
      "input_type": "password",
      "hint": "Stored encrypted by TREK and used only by the plugin server to sign in to Endurain."
    }
  ]
}
